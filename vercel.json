{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/best-pest-control-software",
      "destination": "/pest-control/",
      "statusCode": 301
    },
    {
      "source": "/best-pest-control-software/",
      "destination": "/pest-control/",
      "statusCode": 301
    },
    {
      "source": "/best-lawn-care-software",
      "destination": "/lawn-care/",
      "statusCode": 301
    },
    {
      "source": "/best-lawn-care-software/",
      "destination": "/lawn-care/",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/og/(.*).png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, immutable, no-transform, max-age=31536000"
        }
      ]
    },
    {
      "source": "/logos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, immutable, no-transform, max-age=31536000"
        }
      ]
    },
    {
      "source": "/(favicon.ico|icon.svg|apple-icon.png|icon-512.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, immutable, no-transform, max-age=31536000"
        }
      ]
    }
  ]
}
